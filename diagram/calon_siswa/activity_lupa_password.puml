@startuml
skinparam linetype ortho
mainframe act Lupa Password
|Calon Siswa|
start
:Buka Halaman Login;
:Pilih "Lupa Password?";
|Sistem|
:Tampilkan Form Input NIS & No. HP;
|Calon Siswa|
:Masukkan NIS dan Nomor HP yang terdaftar;
:Klik "Kirim Permintaan Reset";
|Sistem|
:Cek kecocokan NIS & No. HP di Database;
if (Data Cocok?) then (Ya)
  :Ambil Data No Pendaftaran & Kode Registrasi;
  :Tampilkan No Pendaftaran dan Kode Registrasi\nlangsung di layar aplikasi;
  |Calon Siswa|
  :Mencatat / Menyalin Kredensial Login;
  :Kembali ke Halaman Login untuk masuk;
else (Tidak)
  :Tampilkan Pesan Error "NIS atau No. HP Tidak Ditemukan";
endif
stop
@enduml

