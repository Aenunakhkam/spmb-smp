@startuml Use_Case_Diagram
skinparam linetype ortho
left to right direction

actor "Calon Siswa" as Siswa
actor "Administrator" as Admin

package "Sistem Penerimaan Murid Baru" {
    ' Urutan Use Case ditata sedemikian rupa agar garis tidak menyilang
    usecase "Melihat Informasi" as UC1
    usecase "Pendaftaran Awal" as UC2
    usecase "Lengkapi Biodata" as UC3
    usecase "Cek Status" as UC4
    usecase "Cetak Bukti Lulus" as UC5
    
    usecase "Login Sistem" as UC6
    usecase "Dashboard Statistik" as UC7
    usecase "Kelola Pendaftar" as UC8
    usecase "Verifikasi Data" as UC9
    usecase "Seleksi Otomatis" as UC10
    usecase "Cetak Laporan" as UC11
    usecase "Pengaturan Kuota" as UC12
}

' Siswa berada di sisi KIRI
Siswa --> UC1
Siswa --> UC2
Siswa --> UC3
Siswa --> UC4
Siswa --> UC5

' Admin diletakkan di sisi KANAN dengan arah panah terbalik
UC6 <-- Admin
UC7 <-- Admin
UC8 <-- Admin
UC9 <-- Admin
UC10 <-- Admin
UC11 <-- Admin
UC12 <-- Admin
@enduml
